# Secrets
.streamlit/secrets.toml

# Database (local only — all app data lives here)
data/invoiceapp.db

# Generated invoice files
exports/
__pycache__/
*.pyc
*.pyo
.env

# HR / compensation sensitive data
# Bonus templates, time-charge CSVs, and Excel source files must not be committed.
# See SENSITIVE_FILES.md for their local machine paths.
Review/
data/*.csv
data/*.xlsx
data/*.xls
data/*.xlsm
data/time_charges/

# Temp Office lock files
~$*

# Timesheet extract CSVs (sensitive employee billing data)
_timecharges/

# Claude Code internal / worktree state
.claude/

# Old app version folder (contains secrets)
Updated_Invoice_v2/

# DB table exports in DB_Tbls_Structure — all data files excluded, .md docs kept
DB_Tbls_Structure/*.csv
DB_Tbls_Structure/*.xlsx
DB_Tbls_Structure/*.xls
DB_Tbls_Structure/~$*
